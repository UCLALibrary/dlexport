###
## This file contains the environment variables used to
## provision a local/development database container.
##
## These environment variables are not used to provision the
## production database.
##
## Fake values are arbitrary and are OK for version control.
###

# Used to connect to the local PostgreSQL container
DLEXPORT_DB_HOST=db
DLEXPORT_DB_PORT=5432
DLEXPORT_DB_NAME=dlexport_db
DLEXPORT_DB_USER=dlexport_db
DLEXPORT_DB_PASSWORD=dev_password

# PostgreSQL container requires specific variable names
POSTGRES_DB=${DLEXPORT_DB_NAME}
POSTGRES_USER=${DLEXPORT_DB_USER}
POSTGRES_PASSWORD=${DLEXPORT_DB_PASSWORD}
